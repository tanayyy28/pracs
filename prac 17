ClearAll;

f[z_] = Exp[z/2];

z[t_] = Sin[t] + I Cos[t];

val = Integrate[f[z[t]] * z'[t], {t, 0, 2 Pi}];

V[t_] = ComplexExpand[{Re[z[t]], Im[z[t]]}];

g1 = ParametricPlot[
   Evaluate[V[t]],
   {t, 0, 2 Pi},
   PlotRange -> {{-2, 2}, {-2, 2}},
   Ticks -> {Range[-2, 2, 1], Range[-2, 2, 1]},
   AxesLabel -> {"Real Axis", "Imaginary Axis"},
   PlotStyle -> Blue
   ];

g2 = Graphics[{PointSize[0.03], Point[{0, 0}]}];

Show[g1, g2]

Print["The value of the contour integration ",
 "∮c ", f[z], "dz is ",
 "∫_0^(2π) ", "f[z[t]]*z'[t]", "dt = ", val];

Print["where C: z[t] = ", z[t], ", for 0 ≤ t ≤ 2π"];




